# ------------------------------------------------------------------
# ACE Language Centre — Environment Variables (EXAMPLE)
# Copy this file to `.env` (local) or set these in your host (Vercel).
# NEVER commit real secrets. This file contains placeholders only.
# ------------------------------------------------------------------

# PostgreSQL connection string (required for enquiries / AIEP / newsletter storage)
# Local example:
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ------------------------------------------------------------------
# Email notifications (optional).
# All enquiries, contact forms, AIEP applications and newsletter
# signups are emailed to NOTIFY_EMAIL. If SMTP is not configured,
# submissions are still saved to the database and email is skipped.
# ------------------------------------------------------------------
NOTIFY_EMAIL="info@acelanguagecentre.my"
MAIL_FROM="ACE Language Centre <info@acelanguagecentre.my>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
